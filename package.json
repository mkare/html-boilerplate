{
  "name": "bootstrap-boilerplate-html",
  "version": "0.0.1",
  "description": "Bootstrap 5, Webpack5, Scss",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "node scripts/start-dev.cjs",
    "build": "webpack build --mode production",
    "build:demo": "node scripts/build-demo.cjs",
    "build:preview": "webpack build --mode production --env profile=catalog-preview",
    "build:release": "webpack build --mode production --env profile=release-html",
    "preview": "node scripts/preview.cjs",
    "qa:visual-acceptance": "node qa/visual/acceptance.mjs",
    "qa:axe": "node qa/accessibility/run-axe.cjs",
    "check:axe": "node qa/accessibility/check-preview-axe.cjs",
    "check:dist": "node qa/check-dist.cjs",
    "check:collections": "node qa/check-collections.cjs",
    "check:autoprefixer": "node qa/check-autoprefixer.cjs",
    "check:reproducible": "node qa/check-reproducible.cjs",
    "check:fonts": "node qa/check-font-assets.cjs",
    "check:accessibility": "node qa/accessibility/check-markup.cjs",
    "check:watch": "node qa/phase-1/check-watch.cjs",
    "check:overrides": "node qa/overrides/check-project-overrides.cjs",
    "check:links": "node qa/check-dist.cjs",
    "check:architecture": "node qa/check-architecture.cjs",
    "check:route-inventory": "node qa/phase-0/check-route-inventory.cjs",
    "check:ui-primitives": "node qa/ui/check-shared-primitives.cjs",
    "check:manifest-wrapper": "node qa/phase-1/check-manifest-wrapper.cjs",
    "check:runtime-sharing": "node qa/phase-1/check-runtime-sharing.cjs",
    "check:phase2": "node qa/phase-2/check-shell.cjs",
    "check:button-attributes": "node qa/phase-3/check-button-attributes.cjs",
    "check:catalog-source-parity": "node qa/phase-3/check-catalog-source-parity.cjs",
    "check:bootstrap-classes": "node qa/check-bootstrap-classes.cjs",
    "check:commerce": "node --test qa/commerce/*.test.mjs",
    "check:profile-contracts": "node qa/phase-5/check-contracts.cjs",
    "check:locales": "node qa/phase-5/check-locales.cjs",
    "check:block-composition": "node qa/phase-5/check-block-composition.cjs",
    "check:profile": "node qa/phase-5/check-profile.cjs",
    "check:assets": "node --test qa/assets/*.test.mjs",
    "check:source-quality-fixtures": "node scripts/source-quality/check-fixtures.cjs",
    "lint:js": "eslint webpack.config.js eslint.config.mjs stylelint.config.mjs src build config scripts qa",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:pug": "pug-lint src",
    "lint:bootstrap-classes": "yarn check:bootstrap-classes",
    "lint:markdown": "markdownlint-cli2",
    "lint": "yarn lint:js && yarn lint:styles && yarn lint:pug && yarn lint:bootstrap-classes && yarn lint:markdown",
    "format:check": "prettier --check --plugin @prettier/plugin-pug package.json eslint.config.mjs stylelint.config.mjs .pug-lintrc.json .markdownlint-cli2.jsonc .prettierrc.json scripts/source-quality/*.cjs docs/guides/source-quality.md src/content/locales/hreflang.pug",
    "create:page": "node scripts/create-page.cjs",
    "create:component": "node scripts/create-component.cjs",
    "create:demo": "node scripts/create-demo.cjs",
    "package:release": "node scripts/package-release.cjs",
    "check:release": "node qa/release/check-release.cjs",
    "check:release:scaffolds": "node qa/release/test-scaffolds.cjs",
    "check:budget-report": "node qa/release/test-measure-budgets.cjs",
    "check:release:upgrade": "node qa/release/rehearse-upgrade.cjs",
    "ci:build": "yarn lint && yarn format:check && yarn check:source-quality-fixtures && yarn check:assets && yarn check:architecture && yarn check:ui-primitives && yarn check:route-inventory && yarn check:manifest-wrapper && yarn check:runtime-sharing && yarn check:budget-report && yarn check:collections && yarn check:autoprefixer && yarn check:commerce && yarn check:profile-contracts && yarn check:locales && yarn check:block-composition && yarn check:watch && yarn check:overrides && yarn build && yarn check:dist && yarn check:reproducible && yarn check:fonts && yarn check:accessibility && yarn check:profile && yarn check:phase2 && yarn check:button-attributes && yarn check:catalog-source-parity && yarn check:release && yarn check:axe",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "author": "MKare",
  "license": "ISC",
  "peerDependencies": {
    "markdown-it": ">=12",
    "parse5": ">=7.1.2",
    "prismjs": ">=1.29.0"
  },
  "peerDependenciesMeta": {
    "markdown-it": {
      "optional": true
    },
    "parse5": {
      "optional": true
    },
    "prismjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@prettier/plugin-pug": "3.4.2",
    "autoprefixer": "10.6.1",
    "axe-core": "4.13.0",
    "bootstrap": "^5.3.3",
    "browserslist": "4.29.3",
    "caniuse-lite": "1.0.30001814",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "markdown-it": "^14.3.2",
    "markdownlint-cli2": "0.23.3",
    "parse5": "7.1.2",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "postcss-loader": "8.2.1",
    "prettier": "3.9.9",
    "prismjs": "^1.30.0",
    "pug": "^3.0.2",
    "pug-lint": "2.7.0",
    "pug-plugin": "^5.3.0",
    "sass": "^1.55.0",
    "sass-loader": "^13.1.0",
    "sharp": "0.35.5",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
