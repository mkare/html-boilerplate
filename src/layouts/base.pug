//- Compatibility adapter for legacy page `extends` statements.
//- Removal floor: 2.0.0 after legacy page records are migrated; see docs/migrations/upgrade-guide.md.
extends @layouts/document.pug

block layoutHeader
  if !["minimal", "agency"].includes(shellLayout)
    include @components/header.pug

block layoutFooter
  if ["site", "storefront", "docs"].includes(shellLayout)
    include @layouts/site-footer.pug
