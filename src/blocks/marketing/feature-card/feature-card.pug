mixin marketingFeatureCard(options = {})
  - const props = assertProps('block-marketing-feature-card', options, { type: 'object', required: ['eyebrow', 'title', 'description', 'iconTone'], properties: { eyebrow: { type: 'string', minLength: 1 }, title: { type: 'string', minLength: 1 }, description: { type: 'string', minLength: 1 }, iconTone: { type: 'string', enum: ['violet', 'orange', 'mint', 'blue', 'rose'] }, featured: { type: 'boolean' }, bullets: { type: 'array' } }, additionalProperties: false })
  - if (props.bullets && (!Array.isArray(props.bullets) || props.bullets.some((item) => typeof item !== 'string' || !item.trim()))) throw new Error('block-marketing-feature-card bullets must be non-empty strings')
  article.feature-card(class=props.featured ? 'feature-card--featured' : undefined)
    .feature-card__icon(class=`feature-card__icon--${props.iconTone}`, aria-hidden="true")
      if block
        block
    p.feature-card__eyebrow= props.eyebrow
    h3= props.title
    p= props.description
    if props.bullets && props.bullets.length
      ul.feature-card__mini-list
        each item, index in props.bullets
          li
            i(aria-hidden="true")
            = item
