extends @layouts/base.pug

block head
  link(href="./forgot-password.scss" rel="stylesheet")
  script(src="./forgot-password.js" defer="defer")

block content
  section.auth-page.auth-page--forgot(aria-labelledby="forgot-password-title")
    .container.auth-page__shell
      aside.auth-showcase(aria-labelledby="forgot-showcase-title")
        .auth-showcase__top
          a.auth-showcase__brand(href=route("legacy.home"), aria-label="Back to home")
            span.auth-showcase__brand-mark(aria-hidden="true") ◒
            span Northstar
        .auth-showcase__content
          p.auth-eyebrow Account recovery
          h2#forgot-showcase-title Regain access in a few simple steps.
          p.auth-showcase__copy We will send a secure, time-limited link to help you reset your password safely.
          ul.auth-showcase__points
            li Recovery links expire automatically after a short window
            li Your existing password is never shown or exposed
            li Our support team is here if you need assistance
        .auth-showcase__footer
          blockquote.auth-showcase__quote
            | “Trust and security are fundamental to the product experience.”
            cite — Northstar security standard
      .auth-card-wrap
        .auth-card
          a.auth-back-link(href=route("legacy.auth.login")) Back to sign in
          p.auth-eyebrow Password recovery
          h1#forgot-password-title Forgot your password?
          p.auth-card__lead Enter your email address; if an account matches, we'll send reset instructions.
          form#forgot-password-form.auth-form(data-auth-form, data-auth-mode="recovery")
            p.auth-demo-note This demo is not connected to a server. Without JavaScript, fields remain disabled and no email is sent.
            fieldset.auth-form__fields(data-auth-fields, disabled)
              legend.auth-form__legend Password reset details
              .auth-field
                label.auth-label(for="forgot-password-email")
                  | Email address
                  span.auth-required(aria-hidden="true")  *
                input#forgot-password-email(type="email", name="email", autocomplete="email", inputmode="email", placeholder="you@example.com", required, aria-describedby="forgot-password-hint")
                p#forgot-password-hint.auth-hint No account information is validated or disclosed on this screen.
              button.auth-submit(type="submit", data-submit-button, data-pending-label="Sending reset link")
                span(data-submit-label) Send reset link
                span.auth-submit__spinner(aria-hidden="true")
            p#forgot-password-feedback.auth-feedback(role="status", aria-live="polite", data-auth-feedback)
          .auth-help-note
            span.auth-help-note__icon(aria-hidden="true") ?
            p
              | If you no longer have access to this email, 
              a.auth-text-link(href="mailto:support@example.com") contact our support team
              | . Verification may be required for account security.
          p.auth-card__footer
            | Remember your password? 
            a.auth-text-link(href=route("legacy.auth.login")) Sign in
