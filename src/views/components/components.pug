        section#overlays.doc-section(aria-labelledby="overlays-title", data-doc-section)
          .section-heading
            p.eyebrow 10 / Overlays
            h2#overlays-title Dialogs and notifications
            p Use an overlay for a focused decision, not for ordinary navigation. The native dialog element handles focus containment and Escape-to-close behavior for us.
          .docs-example.overlay-demo
            .overlay-demo__copy
              p.sample-card__label Native dialog & live region
              h3 Feedback is brief, clear, and reversible where possible.
              p The dialog restores focus to its trigger after it closes. The toast is announced without interrupting reading.
            .component-row
              button#open-dialog.button.button--primary(
                type="button",
                aria-controls="component-dialog"
              ) Open dialog
              button#show-toast.button.button--secondary(type="button") Show toast
          dialog#component-dialog(
            data-ui-dialog,
            aria-labelledby="dialog-title",
            aria-describedby="dialog-description"
          )
            form.dialog__form(method="dialog")
              p.eyebrow Quick action
              h3#dialog-title Add a component
              p#dialog-description This dialog uses a native HTML element with a focused, minimal surface.
              .field
                label(for="component-name") Component name
                input#component-name(
                  type="text",
                  name="component-name",
                  placeholder="e.g. Toast",
                  autocomplete="off",
                  required
                )
              .form-actions
                button.button.button--ghost(type="submit", value="cancel") Cancel
                button.button.button--primary(type="submit", value="confirm") Add component
          .docs-example.docs-example--compact
            .component-row
              button.button.button--secondary(type="button", aria-controls="help-dialog") Open another dialog
          dialog#help-dialog(
            data-ui-dialog,
            aria-labelledby="help-dialog-title",
            aria-describedby="help-dialog-description"
          )
            form.dialog__form(method="dialog")
              h3#help-dialog-title Another native dialog
              p#help-dialog-description Each dialog keeps its own opener and returns focus after closing.
              button.button.button--primary(type="submit") Close

    output#toast.docs-toast(role="status", aria-live="polite", aria-atomic="true", hidden)
