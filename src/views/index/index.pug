extends @layouts/base.pug

block head
  link(href="./index.scss" rel="stylesheet")
  script(src="./index.js" defer="defer")

block content
  section.home-hero(aria-labelledby="home-title")
    .page-shell.home-hero__layout
      .home-hero__content
        p.eyebrow Multipurpose UI kit
        h1#home-title Turn every idea into an organized interface.
        p.home-hero__lead Page templates, accessible HTML components, and small yet effective interactions working with the same design language. We provide the finished feel, not just a starting line.
        .home-hero__actions
          a.button.button--primary(href=route("legacy.templates")) Explore templates
          a.button.button--ghost(href=route("legacy.components")) Open UI Library
        dl.home-hero__stats(aria-label="Kit summary")
          .home-hero__stat
            dt 06
            dd Page templates
          .home-hero__stat
            dt 40+
            dd UI patterns
          .home-hero__stat
            dt 0
            dd UI dependencies
      .home-hero__visual(aria-hidden="true")
        .home-workspace
          .home-workspace__top
            .home-workspace__identity
              span.home-workspace__mark
              span.home-workspace__wordmark Studio
            .home-workspace__window-actions
              i
              i
              i
          .home-workspace__body
            aside.home-workspace__sidebar
              span.home-workspace__nav-line.home-workspace__nav-line--active
              span.home-workspace__nav-line
              span.home-workspace__nav-line
              span.home-workspace__nav-line
            .home-workspace__main
              .home-workspace__headline
                span
                b
